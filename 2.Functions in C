#include <stdio.h>
/*
 *FUNCTION TO FIND THE MAXIMUM OF FOUR INTEGERS
 *USES HELPER LOGIC TO COMPARE TWO NUMBERS AT A TIME
 */
 int max_of_four(int a, int b, int c, int d){
    int max = a;
    
    if (b > max){
        max = b;
    }
    if (c > max){
        max = c;
    }
    if (d > max){
        max = d;
    }
    
    return max;
 }

int main() {
    int a, b, c, d;
    //READ FOUR INTEGERS, ONE FROM EACH LINE
    scanf("%d %d %d %d", &a, &b, &c, &d);
    //CALL max_of_four(a,b,c,d);
    int ans = max_of_four(a, b, c, d);
    
    //OUTPUT THE GREATEST INTEGER
    printf("%d\n", ans);
    
    return 0;
}
